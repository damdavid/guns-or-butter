{
  // Mostly a static site served from `site/`. The Worker only answers the paths in
  // `run_worker_first`: logging game starts, and the /reports page behind Access.
  // Because mitchthefat.com is already on Cloudflare DNS the custom domain below
  // provisions its own record and certificate.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guns-or-butter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/reports", "/reports/"],
    // `/play` serves play.html, and a bad path gets a 404 rather than the home page —
    // there is no client-side router here for it to hand off to.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guns-or-butter",
      "database_id": "27d360e5-0fe3-41d6-a351-f898be9256f5"
    }
  ],
  "routes": [
    { "pattern": "gb.mitchthefat.com", "custom_domain": true }
  ]
}
